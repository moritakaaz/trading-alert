# Copy this to `.env` and fill in your own keys. NEVER commit `.env`.
# .env must stay local — it is covered by .gitignore.

# Telegram bot token from @BotFather, and your numeric chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twelve Data API key (https://twelvedata.com) — primary XAU/USD price feed
TWELVE_DATA_API_KEY=

# Finnhub API key (https://finnhub.io) — optional, forex news headline warnings
FINNHUB_API_KEY=

# FRED API key (https://fred.stlouisfed.org) — optional, economic calendar (NFP/CPI/PPI/GDP)
FRED_API_KEY=
